# Required
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Comma-separated Telegram user IDs, no spaces. A single ID is fine.
# Anyone listed can read the entire archive via /ask and /recall.
# Leave empty ONLY for local testing — an empty list means the bot is open.
ALLOWED_USER_ID=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Embeddings. Provider is openai | voyage | nvidia; each needs its own key.
# OpenAI is the default: a published deprecation policy, and 1536 dims sits
# under pgvector's 2000-dimension index cap. NVIDIA retired two embedding
# models and hung a third inside 24 hours — it is kept only as a fallback.
# HERMES_EMBED_PROVIDER must match on the dashboard, or search silently
# returns nothing.
HERMES_EMBED_PROVIDER=openai
OPENAI_API_KEY=
#VOYAGE_API_KEY=
#HERMES_EMBED_MODEL=text-embedding-3-small
#HERMES_EMBED_DIMS=1536

# Optional — model routing. Defaults shown.
# "smart" answers and judges (OpenRouter); "fast" does the mechanical volume
# work inside agents (NVIDIA NIM). Overriding fast is the main cost lever.
#HERMES_SMART_MODEL=anthropic/claude-sonnet-5
#HERMES_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
